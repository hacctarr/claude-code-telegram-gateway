{
  "title": "Telegram Gateway",
  "uid": "telegram-gateway",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Logs source",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Log filter",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Topic create failures (rate-limited)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(gateway_topic_create_failed_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Topic backoff seconds",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "gateway_topic_backoff_seconds_max",
          "legendFormat": "max backoff"
        }
      ]
    },
    {
      "id": 3,
      "title": "Turns & injections by repo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (repo) (rate(gateway_claude_turn_total[15m]))",
          "legendFormat": "turns {{repo}}"
        },
        {
          "expr": "sum by (repo) (rate(gateway_drive_injection_total[15m]))",
          "legendFormat": "injections {{repo}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active sessions",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(gateway_sessions_active)",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uptime (gateway_up)",
      "type": "state-timeline",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(gateway_up)",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 22,
      "title": "Send failures by reason",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(gateway_send_failed_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 39,
      "title": "Stalled mirror batches",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_mirror_batch_stalled_total[5m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 64,
      "title": "Mirror backoff seconds",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "gateway_mirror_backoff_seconds_max",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 200,
      "title": "Tokens & cost",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 201,
      "title": "Token rate by type",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Tokens/sec by type. cache_creation is usually the dominant cost driver.",
      "targets": [
        {
          "expr": "sum by (type) (rate(gateway_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 202,
      "title": "Total cost ($__range)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total claude spend over the dashboard range, from total_cost_usd.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(increase(gateway_cost_usd_total[$__range]))",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 203,
      "title": "Cost rate by repo (USD/hr)",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 33,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Spend rate per repo, projected to USD/hour.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (repo) (rate(gateway_cost_usd_total[$__rate_interval])) * 3600",
          "legendFormat": "{{repo}}"
        }
      ]
    },
    {
      "id": 100,
      "title": "Logs",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "title": "Gateway logs (Loki)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 10
      },
      "description": "Gateway logs shipped by Grafana Alloy from gateway.log. (?i)$search is a valid match-all when the filter box is empty.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"telegram-gateway\"} |~ \"(?i)$search\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A"
        }
      ]
    }
  ]
}
